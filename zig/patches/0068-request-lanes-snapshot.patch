 };
 
+/// A request's place in the engine, as GET /lanes reports it. `waiting` covers the queue and parked restores;
+/// `prefill` a prompt pass; `decode` a reply being generated; `finished` a request that ended (only in `recent`).
+pub const Phase = enum { waiting, prefill, decode, finished };
+
+/// One request's state at the moment a status read took it. Tokens a backend did not report are null, and every
+/// count is what the host itself has seen: no device synchronization, no clock read on the engine thread.
+pub const lane_message_max = 96;
+
+pub const LaneRequest = struct {
+    id: Id,
+    phase: Phase = .waiting,
+    /// The backend's pool slot (dsv41's lane), or -1 while none is assigned.
+    slot: i32 = -1,
+    prompt_tokens: u64 = 0,
+    /// Prompt tokens restored from a kept state (the pass starts there).
+    cached_tokens: u64 = 0,
+    /// Prompt tokens the pass has computed (null: the backend reports no progress).
+    prefill_tokens: ?u64 = null,
+    /// Reply tokens committed to the caller.
+    generated_tokens: u64 = 0,
+    max_tokens: u64 = 0,
+    /// Milliseconds since the request was submitted, and since it entered its phase.
+    elapsed_ms: u64 = 0,
+    phase_ms: u64 = 0,
+    /// Why a finished request ended (null while live).
+    reason: ?Reason = null,
+    /// The engine's words for a failure, empty otherwise. Inline: the caller owns a stable snapshot after the
+    /// engine lock is released (no pointer into the host's mutable recent ring).
+    message: [lane_message_max]u8 = @splat(0),
+    message_len: usize = 0,
+};
+
+/// What a status read found: `live` requests (in the caller's buffer, waiting ones first) and `recent` finished
+/// ones (newest first). `dropped` counts live requests past the caller's buffer; `truncated` says `recent` lost the
+/// oldest of the finished ring.
+pub const Requests = struct {
+    live: usize = 0,
+    recent: usize = 0,
+    dropped: u64 = 0,
+    truncated: bool = false,
+    /// The engine keeps per-request state (false: it reports none; the lists are empty).
+    reported: bool = false,
+};
+
 pub const Status = struct {
     /// Requests in prefill or decode, and those waiting for a lane.
     running: u32 = 0,
@@ -411,6 +455,9 @@ pub const Engine = struct {
         /// Ends a request between rounds; its ``finished`` (cancelled) still arrives. Unknown ids are ignored.
         cancel: *const fn (ctx: *anyopaque, id: Id) void,
         status: *const fn (ctx: *anyopaque, out: *Status, stream_tokens: []u32) void,
+        /// Per-request state for GET /lanes, copied under the host's lock into the caller's buffers (null: the
+        /// engine reports none, and the route says so).
+        requests: ?*const fn (ctx: *anyopaque, live: []LaneRequest, recent: []LaneRequest) Requests = null,
         /// Device memory in bytes, the peak since the last reset; null when the backend keeps no count.
         memory: *const fn (ctx: *anyopaque, reset_peak: bool) ?Memory,
         /// The engine's queue as a keepalive target, or null when the backend is not Metal.
@@ -431,6 +478,11 @@ pub const Engine = struct {
     pub fn status(e: Engine, out: *Status, stream_tokens: []u32) void {
         e.vtable.status(e.ctx, out, stream_tokens);
     }
+    /// Per-request state; `reported` is false when the engine keeps none.
+    pub fn requests(e: Engine, live: []LaneRequest, recent: []LaneRequest) Requests {
+        const f = e.vtable.requests orelse return .{};
+        return f(e.ctx, live, recent);
+    }
     pub fn memory(e: Engine, reset_peak: bool) ?Memory {
         return e.vtable.memory(e.ctx, reset_peak);
     }
