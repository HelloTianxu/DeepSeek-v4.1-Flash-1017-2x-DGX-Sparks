+
+test "GET /lanes' rows: prompt progress, finished handoff and stable recent message" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    const Watch = struct {
+        mutex: std.Io.Mutex = .init,
+        chunks: usize = 0,
+        fn hook(ctx: *anyopaque, _: *lanes.stream.Stream, _: usize) void {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            w.mutex.lockUncancelable(std.testing.io);
+            w.chunks += 1;
+            w.mutex.unlock(std.testing.io);
+            std.Io.sleep(std.testing.io, .fromMilliseconds(20), .awake) catch {};
+        }
+        fn count(w: *@This()) usize {
+            w.mutex.lockUncancelable(std.testing.io);
+            defer w.mutex.unlock(std.testing.io);
+            return w.chunks;
+        }
+    };
+    var watch: Watch = .{};
+    var target: lanes.fake.Fake = .{ .gpa = gpa, .prefill_chunks = 4, .prefill_hook = Watch.hook, .prefill_hook_ctx = &watch };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 1 });
+    try host.start();
+    defer host.stop();
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        done: ?Reason = null,
+        engine: ?api.Engine = null,
+        handoff_ok: bool = false,
+        fn event(ctx: *anyopaque, id: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            if (e.* == .finished) {
+                // Re-enter at the exact completion handoff: the job is already absent from live and present once in recent.
+                var live: [4]api.LaneRequest = @splat(.{ .id = 0 });
+                var recent: [4]api.LaneRequest = @splat(.{ .id = 0 });
+                const got = b.engine.?.requests(&live, &recent);
+                var live_n: usize = 0;
+                var recent_n: usize = 0;
+                for (live[0..got.live]) |r| if (r.id == id) {
+                    live_n += 1;
+                };
+                for (recent[0..got.recent]) |r| if (r.id == id) {
+                    recent_n += 1;
+                };
+                b.mutex.lockUncancelable(std.testing.io);
+                b.handoff_ok = live_n == 0 and recent_n == 1;
+                b.done = e.finished.reason;
+                b.mutex.unlock(std.testing.io);
+            }
+        }
+        fn state(b: *@This()) struct { ?Reason, bool } {
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            return .{ b.done, b.handoff_ok };
+        }
+        fn wait(b: *@This(), ms: usize) ?Reason {
+            for (0..ms) |_| {
+                if (b.state()[0]) |r| return r;
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+            return b.state()[0];
+        }
+    };
+    const prompt = [_]u32{ 2, 7, 1, 8, 3, 5, 6 };
+    var box: Box = .{};
+    const e = host.engine();
+    box.engine = e;
+    try e.submit(41, &.{ .prompt = &prompt, .max_tokens = 8 }, .{ .ctx = &box, .event = Box.event });
+    var live: [8]api.LaneRequest = @splat(.{ .id = 0 });
+    var recent: [8]api.LaneRequest = @splat(.{ .id = 0 });
+    var saw_prefill = false;
+    var saw_progress = false;
+    for (0..500) |_| {
+        const got = e.requests(&live, &recent);
+        for (live[0..got.live]) |r| if (r.id == 41 and r.phase == .prefill) {
+            saw_prefill = true;
+            if (r.prefill_tokens) |n| if (n > 0 and n <= prompt.len) {
+                saw_progress = true;
+            };
+        };
+        if (box.state()[0] != null) break;
+        std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+    }
+    try std.testing.expect(watch.count() > 0);
+    try std.testing.expect(saw_prefill);
+    try std.testing.expect(saw_progress);
+    try std.testing.expectEqual(@as(?Reason, Reason.length), box.wait(1000));
+    try std.testing.expect(box.state()[1]);
+    const after = e.requests(&live, &recent);
+    try std.testing.expectEqual(@as(usize, 0), after.live);
+    try std.testing.expect(after.recent >= 1);
+    try std.testing.expectEqual(@as(Id, 41), recent[0].id);
+    try std.testing.expectEqual(api.Phase.finished, recent[0].phase);
+    try std.testing.expectEqual(@as(?Reason, Reason.length), recent[0].reason);
+    try std.testing.expectEqual(@as(u64, prompt.len), recent[0].prompt_tokens);
+    try std.testing.expectEqual(@as(u64, 8), recent[0].generated_tokens);
+}
