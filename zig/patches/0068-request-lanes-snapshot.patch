+/// GET /lanes: each live request's phase and progress, and the ones that finished since the last read, as the engine
+/// host keeps them (no device synchronization, nothing the engine thread allocates). A backend without per-request
+/// state answers `reported: false`; a dashboard then shows the aggregate counters only.
+pub fn lanes(srv: *Server, conn: *Conn, a: Allocator) !void {
+    var live_rows: [lanes_live_max]api.LaneRequest = @splat(.{ .id = 0 });
+    var recent_rows: [lanes_recent_max]api.LaneRequest = @splat(.{ .id = 0 });
+    const got = srv.engine.requests(&live_rows, &recent_rows);
+    const o = try json.newObject(a);
+    try o.put(a, "reported", .{ .bool = got.reported });
+    try o.put(a, "truncated", .{ .bool = got.truncated });
+    try o.put(a, "dropped", try json.intValue(a, got.dropped));
+    const lv = try a.alloc(Value, got.live);
+    for (live_rows[0..got.live], lv) |r, *v| v.* = try laneRequest(a, r, false);
+    try o.put(a, "live", .{ .array = lv });
+    const rc = try a.alloc(Value, got.recent);
+    for (recent_rows[0..got.recent], rc) |r, *v| v.* = try laneRequest(a, r, true);
+    try o.put(a, "recent", .{ .array = rc });
+    conn.quiet_log = true;
+    routes.sendValue(conn, a, 200, .{ .object = o });
+}
+
+pub const lanes_live_max = 32;
+pub const lanes_recent_max = 16;
+
+/// One request's row: its phase, the numbers the host has, and how long it has been there (finished ones carry why).
+pub fn laneRequest(a: Allocator, r: api.LaneRequest, finished: bool) Allocator.Error!Value {
+    const o = try json.newObject(a);
+    try o.put(a, "id", try json.intValue(a, r.id));
+    try o.put(a, "phase", .{ .string = @tagName(r.phase) });
+    if (!finished) {
+        try o.put(a, "slot", try json.intValue(a, r.slot));
+        try o.put(a, "elapsed_ms", try json.intValue(a, r.elapsed_ms));
+        try o.put(a, "phase_ms", try json.intValue(a, r.phase_ms));
+    } else {
+        try o.put(a, "elapsed_ms", try json.intValue(a, r.elapsed_ms));
+        try o.put(a, "ended_ms_ago", try json.intValue(a, r.phase_ms));
+    }
+    try o.put(a, "prompt_tokens", try json.intValue(a, r.prompt_tokens));
+    try o.put(a, "cached_tokens", try json.intValue(a, r.cached_tokens));
+    if (r.prefill_tokens) |n| try o.put(a, "prefill_tokens", try json.intValue(a, n));
+    try o.put(a, "generated_tokens", try json.intValue(a, r.generated_tokens));
+    try o.put(a, "max_tokens", try json.intValue(a, r.max_tokens));
+    if (r.reason) |why| try o.put(a, "reason", .{ .string = @tagName(why) });
+    if (r.message_len > 0) try o.put(a, "message", .{ .string = try a.dupe(u8, r.message[0..r.message_len]) });
+    return .{ .object = o };
+}
