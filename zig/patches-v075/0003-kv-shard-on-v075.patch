+    try std.testing.expectError(error.MissingField, b.finish(&missing));
+    try std.testing.expectEqual(Field.engram, missing);
+    b.part(.engram, "");
+    _ = try b.finish(null);
+
+    var x = Builder.init();
+    var y = Builder.init();
+    x.part(.engram, "ab");
+    x.part(.engram, "c");
+    y.part(.engram, "a");
