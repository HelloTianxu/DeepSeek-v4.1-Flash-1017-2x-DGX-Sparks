+    }
+    for ([_]u64{ 10, 11 }) |stream| {
+        var p = try pl.planAdmit(gpa, .{ .stream = stream, .slot = @intCast(stream), .size = 8 * C, .source = 7 });
+        defer p.deinit(gpa);
