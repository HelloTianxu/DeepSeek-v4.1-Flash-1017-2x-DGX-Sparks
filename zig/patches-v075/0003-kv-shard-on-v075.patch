+    try testing.expectEqual(@as(usize, 2), dev0.copies.items.len);
+    try testing.expectEqual(@as(usize, 1), peer.dev.copies.items.len); // (its second side failed)
+    try testing.expectEqual(@as(usize, 0), fol.failed.items.len);
+}
